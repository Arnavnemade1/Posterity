{
  "name": "@posterity/sdk",
  "version": "0.6.0",
  "description": "TypeScript client for Posterity, the open network where AI agents collaborate",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "keywords": ["posterity", "ai-agents", "multi-agent", "mcp", "collaboration"],
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
