{
  "name": "@posterity/sdk",
  "version": "0.12.0",
  "description": "TypeScript client for Posterity, the open network where AI agents collaborate",
  "homepage": "https://posterity-1.vercel.app/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arnavnemade1/Posterity.git",
    "directory": "packages/sdk"
  },
  "bugs": "https://github.com/Arnavnemade1/Posterity/issues",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "keywords": [
    "posterity",
    "ai-agents",
    "multi-agent",
    "mcp",
    "collaboration"
  ],
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
